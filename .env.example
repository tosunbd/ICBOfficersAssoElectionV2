# ICB Officers' Association Election System V2 (ballot entry) — configuration
# Copy this file to `.env` (same folder) and adjust.  Relative paths are
# relative to this folder.

# ---------------------------------------------------------------- Security
# Change this on the real server (any long random string).
JWT_SECRET_KEY=change-me-to-a-long-random-string

# The five accounts are created on the first start:
#   SA / sadmin      Super Admin
#   Admin / admin    Admin
#   EC1 / EC1, EC2 / EC2, EC3 / EC3    Election Commissioners
# Passwords are changed in the system (Settings); they are not read from here.

# ------------------------------------------------------------ Ballot entry
# Ballot paper numbers each Election Commissioner enters (username:first-last).
# Applied to the accounts on every start.
ENTRY_RANGES=EC1:1-150,EC2:151-300,EC3:301-455
# Ballot numbers are shown zero-padded to this many digits (001, 002 ...)
BALLOT_NUMBER_DIGITS=3
# Registered voters of the election created on the first start
TOTAL_VOTERS=455

# ---------------------------------------------------------------- Database
# SQLite database file.  {Year} is replaced by the election year: one file per
# election (data/icbOfficerAssoDB2026.db, ...), kept afterwards as the record
# of that election.  The year is normally chosen in Admin -> Settings ->
# Database; ELECTION_YEAR is only the starting value (0 = the current year).
DATABASE_URL=sqlite+aiosqlite:///./data/icbOfficerAssoDB{Year}.db
ELECTION_YEAR=0

# --------------------------------------------------------------- Network
# Origins allowed to call the API.  "*" is fine on a private LAN.
CORS_ORIGINS=*
# Optional fixed API URL baked into the UI at build time.  Leave empty: the
# browser then calls http://<same host as the page>:8000 automatically.
NEXT_PUBLIC_API_URL=
# URL prefix of the UI when it is published through IIS on port 80, e.g.
#   http://192.168.15.57/election/admin  and  /election/dashboard
# Set by "0. install.bat" (keep it in step with IIS_APP_PATH there).  The UI is
# rebuilt automatically by "1. Start.bat" when this changes.  Leave empty to
# serve the UI from the root of http://<host>:3000 instead.
NEXT_PUBLIC_BASE_PATH=/election

# Seconds between full dashboard refreshes (a saved ballot is pushed at once anyway)
SSE_REFRESH_INTERVAL=2
LOG_LEVEL=INFO
